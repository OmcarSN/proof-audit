{
  "name": "proof-audit",
  "version": "0.2.0",
  "description": "ProofAudit — Privacy-preserving smart contract audit attestation on Midnight",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build": "compact compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:preprod": "node --max-old-space-size=16384 --import tsx deploy/deploy.ts preprod",
    "deploy:preview": "node --max-old-space-size=16384 --import tsx deploy/deploy.ts preview"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
